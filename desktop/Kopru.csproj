<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Kopru</AssemblyName>
    <RootNamespace>Kopru</RootNamespace>
    <ApplicationIcon>kopru.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Product>Köprü</Product>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <EmbeddedResource Include="kopru.ico" />
    <EmbeddedResource Include="token.txt" LogicalName="token.txt" Condition="Exists('token.txt')" />
    <EmbeddedResource Include="../app/src/main/assets/index.html" LogicalName="index.html" />
  </ItemGroup>

</Project>
